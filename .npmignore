# Source files
src/
*.ts
!dist/**/*.d.ts

# Config files
tsconfig.json
.env
.env.*

# Development files
.vscode/
.idea/
.claude/
.github/
*.swp
*.swo

# Git files
.git/
.gitignore

# Documentation images/assets
docs/

# Test files
*.test.ts
*.spec.ts
__tests__/
test/
dist-test/

# Generation inputs are not required at runtime
openapi.yml
openapi/
scripts/

# Build artifacts not needed
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Docker files (if running locally)
Dockerfile
.dockerignore

# Node debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
