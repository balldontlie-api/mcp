{
  "name": "@balldontlie/mcp-server",
  "version": "1.2.0",
  "description": "MCP server for BALLDONTLIE sports API endpoints",
  "main": "dist/web-server.js",
  "type": "module",
  "bin": {
    "balldontlie-mcp-server": "./dist/web-server.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/web-server.js",
    "generate:openapi": "node scripts/generate-openapi-tools.mjs",
    "check:openapi": "node scripts/generate-openapi-tools.mjs --check",
    "test": "npm run check:openapi && npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "start": "node dist/web-server.js",
    "dev": "ts-node --esm src/web-server.ts",
    "clean": "rm -rf dist dist-test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/balldontlie-api/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/balldontlie-api/mcp/issues"
  },
  "homepage": "https://github.com/balldontlie-api/mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sports",
    "api",
    "nba",
    "nfl",
    "mlb",
    "epl",
    "nhl",
    "wnba",
    "ncaaf",
    "balldontlie"
  ],
  "author": "BALLDONTLIE",
  "license": "MIT",
  "dependencies": {
    "axios": "1.19.0",
    "dd-trace": "5.120.0",
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "js-yaml": "^5.2.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
